digraph BioPathway {
  rankdir=LR; splines=true; nodesep=0.35;
  node [fontname="Helvetica", fontsize=11, style="filled"];
  edge [fontname="Helvetica", fontsize=9];
  labelloc="t"; label="pathway: hsa05214 | genes: EGFR, PTEN, PIK3CA, TP53, CDK4, RB1";
  n0 [label="EGFR", shape=box, penwidth=3, color="#b8860b", fillcolor="#fff3bf"];
  n1 [label="PIK3CA/P3R3URF-PIK3R3/PIK3CB (+4)", shape=box, penwidth=3, color="#b8860b", fillcolor="#fff3bf"];
  n2 [label="CCND1:CDK4/CDK6", shape=box3d, penwidth=3, color="#b8860b", fillcolor="#fff3bf"];
  n3 [label="RB1", shape=box, penwidth=3, color="#b8860b", fillcolor="#fff3bf"];
  n4 [label="TP53", shape=box, penwidth=3, color="#b8860b", fillcolor="#fff3bf"];
  n5 [label="PTEN", shape=box, penwidth=3, color="#b8860b", fillcolor="#fff3bf"];
  n6 [label="CDKN1A", shape=box, fillcolor="#ffffff"];
  n2 -> n3 [label="activation +p · CUR", color="#2166ac", fontcolor="#2166ac", penwidth=1.6];
  n0 -> n1 [label="activation · CUR", color="#2166ac", fontcolor="#2166ac", penwidth=1.6];
  n6 -> n2 [label="inhibition · CUR", color="#2166ac", fontcolor="#2166ac", penwidth=1.6, arrowhead=tee];
  n4 -> n6 [label="expression · CUR", color="#2166ac", fontcolor="#2166ac", penwidth=1.6, style=dashed];
  legend [shape=plaintext, style="", label=<<TABLE BORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>Evidence</B></TD></TR><TR><TD BGCOLOR="#1b7837" WIDTH="18"></TD><TD ALIGN="LEFT">EXP = experimentally validated</TD></TR><TR><TD BGCOLOR="#2166ac" WIDTH="18"></TD><TD ALIGN="LEFT">CUR = curated database evidence</TD></TR><TR><TD BGCOLOR="#e08214" WIDTH="18"></TD><TD ALIGN="LEFT">PRED = computationally predicted</TD></TR><TR><TD BGCOLOR="#762a83" WIDTH="18"></TD><TD ALIGN="LEFT">LIT = literature-supported association</TD></TR><TR><TD BGCOLOR="#878787" WIDTH="18"></TD><TD ALIGN="LEFT">HYP = hypothetical/insufficiently established</TD></TR></TABLE>>];
}