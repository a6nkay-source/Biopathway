  n7 [label="3-Phospho-D-glycerate", shape=ellipse, fillcolor="#e6f4ea"];
  n8 [label="2-Phospho-D-glycerate", shape=ellipse, fillcolor="#e6f4ea"];
  n9 [label="Phosphoenolpyruvate", shape=ellipse, fillcolor="#e6f4ea"];
