digraph BioPathway {
  rankdir=LR; splines=true; nodesep=0.35;
  node [fontname="Helvetica", fontsize=11, style="filled"];
  edge [fontname="Helvetica", fontsize=9];
  labelloc="t"; label="metabolic: glycolysis | module M00001";
  n0 [label="alpha-D-Glucose", shape=ellipse, fillcolor="#e6f4ea"];
  n1 [label="alpha-D-Glucose 6-phosphate", shape=ellipse, fillcolor="#e6f4ea"];
  n2 [label="D-Fructose 6-phosphate", shape=ellipse, fillcolor="#e6f4ea"];
